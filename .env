# Chave da API da OpenAI (obrigatório)
OPENAI_API_KEY=COLOQUE_SUA_OPENAI_API_KEY_AQUI

# Chave da API da Helius (opcional, mas recomendado para dados on-chain completos)
# Crie uma em: https://dev.helius.xyz/
HELIUS_API_KEY=COLOQUE_SUA_HELIUS_API_KEY_AQUI

# Modelo OpenAI a usar (padrão: gpt-4o)
OPENAI_MODEL=gpt-4o

# RPC Solana mainnet (opcional). Use seu RPC privado se o publico falhar.
# SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
